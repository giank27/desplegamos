---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import FloatingStoreIcons from "../components/FloatingStoreIcons.astro";
---

<Layout title="Desplegamos | Lanzamiento en Tiendas de Apps">
  <main>
    <!-- Sección Inicio: Altura completa de dispositivo y 2 columnas con texto a la izquierda e iconos flotantes a la derecha -->
    <section id="inicio" class="hero-section">
      <div class="container">
        <div class="row align-items-center g-5 py-4">
          <!-- Columna Izquierda: Textos principales -->
          <div class="col-lg-6 text-center text-lg-start">
            <div class="hero-content-box">
              <h1 class="hero-h1">
                Nos encargamos de tu <span class="gradient-text"
                  >lanzamiento</span
                > en tiendas de apps
              </h1>

              <h3 class="hero-h3">
                Confianos el primer paso para asegurar el éxito
              </h3>

              <h5 class="hero-h5">
                Gestionamos el lanzamiento de tu app, tus próximos despliegues y
                te asesoramos antes, durante y después del proceso.
              </h5>
              <h5 class="hero-h5">
                Nos especializamos en la gestión de Apps en tiendas móviles.
              </h5>

              <div
                class="hero-cta-group d-flex flex-column gap-3 align-items-center align-items-lg-start mt-4"
              >
                <a href="#seccion-5" class="btn-app-primary">
                  <span>Haz el primer lanzamiento con nosotros</span>
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="ms-2"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <a href="#seccion-1" class="btn-app-outline">
                  <span>Quiero un acompañamiento personalizado</span>
                </a>
              </div>

              <div
                class="hero-trust-metrics mt-4 pt-3 d-flex flex-wrap gap-4 justify-content-center justify-content-lg-start"
              >
                <div class="metric-item">
                  <span class="metric-check">✓</span>
                  <span>100% de Aprobación</span>
                </div>
                <div class="metric-item">
                  <span class="metric-check">✓</span>
                  <span>Asesoría Continua</span>
                </div>
                <div class="metric-item">
                  <span class="metric-check">✓</span>
                  <span>Soporte Multi-Store</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Columna Derecha: Iconos de tiendas flotando -->
          <div class="col-lg-6">
            <FloatingStoreIcons />
          </div>
        </div>
      </div>
    </section>

    <!-- Sección # 1 -->
    <section id="seccion-1" class="content-section bg-theme-background">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-8 mx-auto text-center">
            <div class="section-box">
              <span class="badge-accent">Módulo 01</span>
              <h2 class="section-title">Sección # 1</h2>
              <p class="section-desc">
                Placeholder para el contenido de la Sección # 1. Maquetado con
                Bootstrap y adaptado a la paleta corporativa.
              </p>
              <div class="row g-3 mt-4 justify-content-center">
                <div class="col-md-4">
                  <div class="p-3 border rounded bg-light text-dark">
                    <h5 class="fw-bold mb-1">Característica A</h5>
                    <small class="text-muted">Detalle del elemento</small>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="p-3 border rounded bg-light text-dark">
                    <h5 class="fw-bold mb-1">Característica B</h5>
                    <small class="text-muted">Detalle del elemento</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección # 2 -->
    <section id="seccion-2" class="content-section bg-theme-secondary">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-8 mx-auto text-center">
            <div class="section-box">
              <span class="badge-accent">Módulo 02</span>
              <h2 class="section-title">Sección # 2</h2>
              <p class="section-desc">
                Placeholder para el contenido de la Sección # 2. Diseñada en
                contraste con fondo oscuro y detalles en color primario.
              </p>
              <div class="row g-3 mt-4 justify-content-center">
                <div class="col-md-4">
                  <div
                    class="p-3 border border-secondary rounded bg-dark text-white"
                  >
                    <h5 class="fw-bold mb-1 text-info">Servicio 1</h5>
                    <small class="text-secondary-emphasis"
                      >Descripción breve</small
                    >
                  </div>
                </div>
                <div class="col-md-4">
                  <div
                    class="p-3 border border-secondary rounded bg-dark text-white"
                  >
                    <h5 class="fw-bold mb-1 text-info">Servicio 2</h5>
                    <small class="text-secondary-emphasis"
                      >Descripción breve</small
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección # 3 -->
    <section id="seccion-3" class="content-section bg-theme-background">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-8 mx-auto text-center">
            <div class="section-box">
              <span class="badge-accent">Módulo 03</span>
              <h2 class="section-title">Sección # 3</h2>
              <p class="section-desc">
                Placeholder para el contenido de la Sección # 3. Estructura
                flexible para componentes interactivos o multimedia.
              </p>
              <div class="mt-4 p-4 border rounded bg-white text-dark">
                <p class="mb-0 fw-semibold text-muted">
                  Bloque de información destacada de la Sección # 3
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección # 4 -->
    <section id="seccion-4" class="content-section bg-theme-secondary">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-8 mx-auto text-center">
            <div class="section-box">
              <span class="badge-accent">Módulo 04</span>
              <h2 class="section-title">Sección # 4</h2>
              <p class="section-desc">
                Placeholder para el contenido de la Sección # 4. Métricas,
                estadísticas o testimonios con diseño responsive.
              </p>
              <div class="row g-4 mt-3 justify-content-center">
                <div class="col-sm-4">
                  <h3 class="fw-bold text-info mb-0">100%</h3>
                  <small class="text-light opacity-75">Responsive</small>
                </div>
                <div class="col-sm-4">
                  <h3 class="fw-bold text-info mb-0">Bootstrap</h3>
                  <small class="text-light opacity-75">v5.3.8</small>
                </div>
                <div class="col-sm-4">
                  <h3 class="fw-bold text-info mb-0">Astro</h3>
                  <small class="text-light opacity-75">v7.3.1</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección # 5 -->
    <section id="seccion-5" class="content-section bg-theme-background">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-8 mx-auto text-center">
            <div class="section-box">
              <span class="badge-accent">Módulo 05</span>
              <h2 class="section-title">Sección # 5</h2>
              <p class="section-desc">
                Placeholder para el contenido de la Sección # 5. Área final o
                pie de landing page para llamadas a la acción o formulario.
              </p>
              <div class="mt-4">
                <a href="#inicio" class="btn-app-primary"> Volver al Inicio </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
